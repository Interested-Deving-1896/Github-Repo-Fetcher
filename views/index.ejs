<!-- views/index.ejs -->
<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card shadow-lg">
      <div class="card-body p-5">
        <h1 class="card-title text-center mb-4">Search GitHub Repos</h1>
        
        <form id="searchForm" method="POST" action="/repos/fetch">
          <!-- Username Input -->
          <div class="mb-3">
            <label for="username" class="form-label">GitHub Username or Organization</label>
            <input 
              type="text" 
              class="form-control form-control-lg" 
              id="username" 
              name="username" 
              placeholder="e.g., torvalds, facebook, google"
              required
              aria-describedby="usernameHelp"
            >
            <small id="usernameHelp" class="form-text text-muted">
              Enter any GitHub username or organization name to fetch their public repos.
            </small>
          </div>

          <!-- Sort Dropdown -->
          <div class="mb-4">
            <label for="sortBy" class="form-label">Sort By (Optional)</label>
            <select 
              class="form-select form-select-lg" 
              id="sortBy" 
              name="sortBy"
              aria-describedby="sortHelp"
            >
              <option value="">Default (Recently Updated)</option>
              <option value="stars">⭐ Most Stars</option>
              <option value="forks">🍴 Most Forks</option>
              <option value="updated">📅 Recently Updated</option>
            </select>
            <small id="sortHelp" class="form-text text-muted">
              Repos are always filtered to those updated in the last 6 months.
            </small>
          </div>

          <!-- Submit Button -->
          <button 
            type="submit" 
            class="btn btn-primary btn-lg w-100"
            id="submitBtn"
          >
            <span id="submitText">🔍 Fetch Repos</span>
            <span id="spinner" class="spinner-border spinner-border-sm ms-2" style="display: none;"></span>
          </button>
        </form>

        <!-- Info Box -->
        <div class="alert alert-info mt-4" role="alert">
          <strong>ℹ️ How it works:</strong> This app fetches public repositories from GitHub, 
          filters those updated in the last 6 months, and lets you sort by stars, forks, or update date. 
          Download results as CSV!
        </div>
      </div>
    </div>
  </div>
</div>
